{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sobeairehab-telemed",
  "compatibility_date": "2024-12-01",
  "compatibility_flags": ["nodejs_compat"],
  "pages_build_output_dir": "./dist"
  
  // NOTE: D1 Database will be configured after creation via wrangler d1 create
  // After creating, add:
  // "d1_databases": [
  //   {
  //     "binding": "DB",
  //     "database_name": "sobeairehab-telemed-db",
  //     "database_id": "YOUR_DATABASE_ID_HERE"
  //   }
  // ]
}
