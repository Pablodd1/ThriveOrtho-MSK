{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sobeairehab-telemed",
  "compatibility_date": "2024-12-01",
  "compatibility_flags": ["nodejs_compat"],
  "pages_build_output_dir": "./dist",
  
  // D1 Database for assessment storage
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "thrive-ortho-db",
      "database_id": "51a6f32c-8f5d-4baf-9591-a822053e4b0c"
    }
  ]
  
  // R2 Storage for video recordings (enable R2 in Cloudflare dashboard first)
  // Then uncomment and run: npx wrangler r2 bucket create thrive-ortho-videos
  // "r2_buckets": [
  //   {
  //     "binding": "R2_BUCKET",
  //     "bucket_name": "thrive-ortho-videos"
  //   }
  // ]
  
  // Environment variables (set via wrangler secret or .dev.vars)
  // TWILIO_ACCOUNT_SID - Your Twilio Account SID
  // TWILIO_AUTH_TOKEN - Your Twilio Auth Token
  // TWILIO_FROM_NUMBER - Your Twilio phone number (+1234567890)
  // RESEND_API_KEY - Your Resend API key
  // RESEND_FROM_EMAIL - From email (e.g., "Thrive Ortho <noreply@yourdomain.com>")
  // GEMINI_API_KEY - Google Gemini API key
}
